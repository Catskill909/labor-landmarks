</div></div></div></div></div><div class="bg-light_gray"><div class="container-fluid anchor" id="search-acir"><div class="row px-lg-5"><div class="col-12 py-5"><div class="hash_mark"></div><h2>Search the Archives</h2><div id="search-box">
	<div id="search-categories" style="width: 400px;">
		<select id="search-dropdown" class="form-select form-select-lg mb-3" onchange="changeTitle()" aria-label="Select search category">
			<option value="all" selected="true">Manuscripts &amp; MU Archives</option>
			<option value="cdm">Digital Collections</option>
			<option value="ir">Institutional Repository</option>
		</select>
	</div>
	<div id="all-box">
		<form action="/search/" method="get" name="all_search_form">
			<input title="Enter search terms to search the archives and manuscripts" id="all" class="searchField" name="ousearchq" size="40" type="text" placeholder="Search the archives and manuscript collections">
			<input type="hidden" name="uq" value="https://www.marquette.edu/library/*">
			<button type="submit" class="btn-primary_gold search-submit">Search</button>
		</form>
	</div>
	<div id="cdm-box">
		<form name="cdm_search_form">
			<input id="cdm" title="Search through the digital collections" class="searchField" name="searchterm" size="40" type="text" placeholder="Search the digital collections">
			<input class="btn-primary_gold search-submit" type="button" value="Search" onclick="handleCDMSearch()">
		</form> 
	</div>
	<div id="ir-box">
		<form action="https://epublications.marquette.edu/do/search/" name="ir_search_form">
			<input id="ir" title="Search the institutional repository" class="searchField" name="q" size="40" type="text" placeholder="Search the institutional repository">
			<button type="submit" class="btn-primary_gold search-submit">Search</button>
		</form> 
	</div>
</div>

<script>

	function handleCDMSearch() {
		var searchTerm = document.getElementById("cdm").value;
		window.open("https://cdm16280.contentdm.oclc.org/digital/search/searchterm/" + searchTerm, "_self");
	}

	document.getElementById("cdm").addEventListener("keypress", function(event) {
		if (event.key === "Enter") {
			// Prevent the default action if needed
			event.preventDefault();
			// Call your function here
			handleCDMSearch();
		}
	});

	/* sets default to All Collections */
	changeTitle("all");

	function changeTitle() {

		var dropdown = document.getElementById("search-dropdown");
		var currentSelect = dropdown.value;

		if (currentSelect === "all") {
			document.getElementById("all-box").style.display = "block";
			//document.getElementById("manuscripts-box").style.display = "none";
			//document.getElementById("archives-box").style.display = "none";
			document.getElementById("cdm-box").style.display = "none";
			document.getElementById("ir-box").style.display = "none";
		}
		else if (currentSelect === "cdm") {
			document.getElementById("all-box").style.display = "none";
			//document.getElementById("manuscripts-box").style.display = "none";
			//document.getElementById("archives-box").style.display = "none";
			document.getElementById("cdm-box").style.display = "block";
			document.getElementById("ir-box").style.display = "none";
		}
		else if (currentSelect === "ir") {
			document.getElementById("all-box").style.display = "none";
			//document.getElementById("manuscripts-box").style.display = "none";
			//document.getElementById("archives-box").style.display = "none";
			document.getElementById("cdm-box").style.display = "none";
			document.getElementById("ir-box").style.display = "block";
		}
	}
	document.addEventListener("DOMContentLoaded", () => {
		const select = document.getElementById("search-dropdown");

		const inputs = {
		  all: document.getElementById("manuscriptsMUArchives"),
		  cdm: document.getElementById("cdmSearchTerm"),
		  ir: document.getElementById("irSearchTerm")
		};
		console.log("select.value:", select.value);
		console.log("inputs keys:", Object.keys(inputs));


		function updateSearchInput() {
		  const value = select.value;
		  const activeInput = inputs[value];

		  // Update accessible name
		  activeInput.setAttribute(
			"aria-label",
			`Search ${select.options[select.selectedIndex].text}`
		  );

		  activeInput.focus();
		}

		select.addEventListener("change", updateSearchInput);
		updateSearchInput();
		
	});
</script>
